# --- Google AI Studio (Gemini API) -------------------------------------------
# Get a free key at https://aistudio.google.com/apikey
# Leave empty to run the game 100% offline with the deterministic fallback AI.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Tried when the main model is overloaded (503), times out or is unavailable.
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite

# Seconds to wait for Gemini before switching to the fallback answer.
AI_TIMEOUT_SECONDS=25
# The end-of-game analysis sends the whole game log, so it gets a longer budget.
AI_FINAL_TIMEOUT_SECONDS=45
# After a quota / rate-limit error, skip Gemini for this many seconds.
AI_COOLDOWN_SECONDS=60
# Disable "thinking" on 2.5 Flash models for faster answers.
GEMINI_DISABLE_THINKING=true

# --- Server -------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SESSION_TTL_MINUTES=240
MAX_SESSIONS=500
